# Starter verb declarations and lifecycle profile examples for the runtime surface.

@doc(
  name: "views",
  doc: "Saved command templates over the Datalog runtime. Projects can add their own @verb declarations with the same shape as these standard verbs."
).

@doc(
  name: "profile_doc_corpus",
  doc: "Return a copyable lifecycle profile for markdown/design corpora that use frontmatter status values like draft, review, stable, and archived."
).
profile_doc_corpus("# Document corpus lifecycle\npipeline_position_for(\"draft\", 0).\npipeline_position_for(\"review\", 1).\npipeline_position_for(\"stable\", 2).\nterminal(h) := status_of(h, \"archived\").\nactive(h) := status_of(h, \"draft\").\nactive(h) := status_of(h, \"review\").\nsettled(h) := status_of(h, \"stable\").").

@doc(
  name: "profile_code_corpus",
  doc: "Return a copyable lifecycle profile for code corpora where symbols move by visibility and deprecation state."
).
profile_code_corpus("# Code corpus lifecycle\npipeline_position_for(\"private\", 0).\npipeline_position_for(\"public\", 1).\npipeline_position_for(\"deprecated\", 2).\nterminal(h) := *meta{handle: h, key: \"code.deprecated\", value: \"true\"}.\nactive(h) := *meta{handle: h, key: \"code.visibility\", value: \"private\"}.\nactive(h) := *meta{handle: h, key: \"code.visibility\", value: \"public\"}.\nsettled(h) := *meta{handle: h, key: \"code.visibility\", value: \"public\"}, not terminal(h).").

@doc(
  name: "profile_issue_corpus",
  doc: "Return a copyable lifecycle profile for issue or task corpora with open, blocked, review, and closed states."
).
profile_issue_corpus("# Issue corpus lifecycle\npipeline_position_for(\"open\", 0).\npipeline_position_for(\"blocked\", 0).\npipeline_position_for(\"review\", 1).\npipeline_position_for(\"closed\", 2).\nterminal(h) := status_of(h, \"closed\").\nactive(h) := status_of(h, \"open\").\nactive(h) := status_of(h, \"blocked\").\nactive(h) := status_of(h, \"review\").\nsettled(h) := terminal(h).").

@doc(
  name: "gitignored_scanned_file",
  doc: "Return Markdown file handles included by configured filesystem scanning that Git classifies as ignored. Rows exist only when Git can classify the physical source origin; no rows do not establish that files are tracked."
).
@predicate(
  name: "gitignored_scanned_file",
  args: ["h", "file"]
).
gitignored_scanned_file(h, h) :=
  *meta{handle: h, key: "md.scan_git_disposition", value: "ignored", source: "markdown"}.

hit_currency_disposition_known(h) :=
  currency_disposition(h, disposition).

hit_currency_disposition(h, disposition) :=
  currency_disposition(h, disposition).

hit_currency_disposition(h, "unknown") :=
  *handle{id: h},
  not hit_currency_disposition_known(h).

@verb(
  name: "status",
  query: "status_metric(\"scale\", \"handles\", count, null) :=\n  count = Count{ h : *handle{id: h} }.\n\nstatus_metric(\"scale\", \"file_handles\", count, null) :=\n  count = Count{ h : *handle{id: h, kind: \"file\"} }.\n\nstatus_metric(\"scale\", \"file_handles_with_status\", count, null) :=\n  count = Count{ h : *handle{id: h, kind: \"file\", status: status}, status != null }.\n\nstatus_metric(\"scale\", \"statusless_file_handles\", count, null) :=\n  count = Count{ h : *handle{id: h, kind: \"file\", status: null} }.\n\nstatus_metric(\"scope\", \"gitignored_markdown_file_handles\", count, null) :=\n  gitignored_scanned_file(sample, sample_file),\n  count = Count{ h : gitignored_scanned_file(h, file) }.\n\nstatus_metric(\"pipeline\", status, count, null) :=\n  configured_pipeline_status(status, level),\n  status_handle_count(status, count).\n\nstatus_metric(\"convergence\", \"broken\", count, null) :=\n  count = Count{ h : status_item(\"broken\", h, score, why) }.\n\nstatus_metric(\"convergence\", \"blocked\", count, null) :=\n  count = Count{ h : status_item(\"blocked\", h, score, why) }.\n\nstatus_metric(\"convergence\", \"open\", count, null) :=\n  count = Count{ h : status_item(\"work\", h, score, why) }.\n\nstatus_metric(\"convergence\", \"advancing\", count, null) :=\n  count = Count{ h : status_item(\"advancing\", h, score, why) }.\n\nstatus_metric(\"convergence\", \"holding\", count, null) :=\n  count = Count{ h : status_item(\"holding\", h, score, why) }.\n\nstatus_metric(\"convergence\", \"drifting\", count, null) :=\n  count = Count{ h : status_item(\"drifting\", h, score, why) }.\n\nstatus_metric(\"health\", \"errors\", count, null) :=\n  count = Count{ h : status_item(\"broken\", h, score, why) }.\n\nstatus_metric(\"health\", \"blockers\", count, null) :=\n  count = Count{ h : status_item(\"blocked\", h, score, why) }.\n\nstatus_metric(\"health\", \"spec_code_drift\", count, null) :=\n  count = Count{ h : spec_code_drift(h, target_path, file, line, source_status) }.\n\nstatus_metric(\"diagnostic_policy\", \"escalated\", count, null) :=\n  count = Count{ code : diagnostic_policy(code, declared, effective, \"project\") },\n  count > 0.\n\nstatus_metric(\"diagnostics\", \"total\", count, null) :=\n  count = Count{ (code, severity, subject, file, line, evidence) : diagnostic(code, severity, subject, file, line, evidence) }.\n\nstatus_metric(\"diagnostics\", \"error\", count, null) :=\n  count = Count{ (code, subject, file, line, evidence) : diagnostic(code, \"error\", subject, file, line, evidence) }.\n\nstatus_metric(\"diagnostics\", \"warning\", count, null) :=\n  count = Count{ (code, subject, file, line, evidence) : diagnostic(code, \"warning\", subject, file, line, evidence) }.\n\nstatus_metric(\"diagnostics\", \"suggestion\", count, null) :=\n  count = Count{ (code, subject, file, line, evidence) : diagnostic(code, \"suggestion\", subject, file, line, evidence) }.\n\nstatus_metric(\"diagnostics\", \"info\", count, null) :=\n  count = Count{ (code, subject, file, line, evidence) : diagnostic(code, \"info\", subject, file, line, evidence) }.\n\nstatus_vocabulary_key(key, distinct_file_handles, reference_name_signal, rank) :=\n  (key, distinct_file_handles, reference_name_signal, rank) = TopK{ k: 3, key: rank :\n    (key, distinct_file_handles, reference_name_signal, rank) :\n      unmodeled_frontmatter_key(key, distinct_file_handles, reference_name_signal, rank)\n  }.\n\nstatus_metric(\"vocabulary\", key, distinct_file_handles, \"reference_name_signal\") :=\n  status_vocabulary_key(key, distinct_file_handles, 1, rank).\n\nstatus_metric(\"vocabulary\", key, distinct_file_handles, null) :=\n  status_vocabulary_key(key, distinct_file_handles, 0, rank).\n\ncode_ref_target(ref) :=\n  *handle{id: ref, kind: \"external\"},\n  *meta{handle: ref, key: \"external_class\", value: \"code\"}.\n\nstatus_metric(\"drift\", \"cold\", count, \"run anneal check --refresh-drift\") :=\n  code_ref_target(sample),\n  count = Count{ ref : code_ref_target(ref), not referent_drift_evidence_present(ref) }.\n\nstatus_metric(\"drift\", \"intact\", count, null) :=\n  code_ref_target(sample),\n  count = Count{ ref : referent_disposition(ref, \"referent-intact\") }.\n\nstatus_metric(\"drift\", \"drifted\", count, null) :=\n  code_ref_target(sample),\n  count = Count{ ref : referent_disposition(ref, bucket), bucket starts_with \"referent-drifted\" }.\n\nstatus_metric(\"drift\", \"moved\", count, null) :=\n  code_ref_target(sample),\n  count = Count{ ref : referent_disposition(ref, \"referent-moved\") }.\n\nstatus_metric(\"drift\", \"moved_ambiguous\", count, null) :=\n  code_ref_target(sample),\n  count = Count{ ref : referent_disposition(ref, \"referent-moved-ambiguous\") }.\n\nstatus_metric(\"drift\", \"gone\", count, null) :=\n  code_ref_target(sample),\n  count = Count{ ref : referent_disposition(ref, \"referent-gone\") }.\n\nstatus_metric(\"drift\", \"unknown\", count, null) :=\n  code_ref_target(sample),\n  count = Count{ ref : referent_disposition(ref, bucket), bucket ends_with \"unknown\" }.\n\nstatus_metric(\"drift\", \"dirty\", count, null) :=\n  code_ref_target(sample),\n  count = Count{ ref : referent_disposition(ref, \"evidence_dirty_worktree\") }.\n\n? status_metric(category, name, count, detail).",
  doc: "Show corpus vital signs: scale, conditional scope disclosures, lifecycle coverage, pipeline histogram, convergence flow, and health counts, with query pointers for orientation and work.", intents: ["How healthy is this corpus and what work remains?", "Show lifecycle coverage and convergence vital signs.", "Report current counts without inventing missing history."],
  output_schema: "{\"category\":\"String\",\"name\":\"String\",\"count\":\"Number\",\"detail\":\"String|null\"}",
  args: [],
  capabilities: ["read"]
).

@verb(
  name: "handle",
  query: "handle_row(h, \"self\", h, kind, status, file, line, summary) :=\n  verb_arg(\"h\", h),\n  *handle{id: h, kind: kind, status: status, file: file, line: line, summary: summary}.\n\nhandle_row(h, \"out\", other, kind, null, file, line, \"\") :=\n  verb_arg(\"h\", h),\n  *edge{from: h, to: other, kind: kind, file: file, line: line}.\n\nhandle_row(h, \"in\", other, kind, null, file, line, \"\") :=\n  verb_arg(\"h\", h),\n  *edge{to: h, from: other, kind: kind, file: file, line: line}.\n\n? handle_row(h, relation, other, kind, status, file, line, summary).",
  doc: "Show one handle, its stored metadata, and the handles immediately connected to it. Use `anneal handle H --impact` when you also need direct and indirect reverse dependencies before editing.", intents: ["What depends on this document before I edit it?", "Inspect one handle and its connected references.", "Show indirect reverse dependencies when impact is requested."],
  output_schema: "{\"h\":\"HandleId\",\"relation\":\"String\",\"other\":\"HandleId\",\"kind\":\"String\",\"status\":\"String|null\",\"file\":\"String\",\"line\":\"Number\",\"summary\":\"String\"}",
  args: ["h:HandleId"],
  capabilities: ["read"]
).

@verb(
  name: "search",
  query: "search_summary(h, span_id, summary) :=\n  *span{handle: h, id: span_id, summary: summary}.\n\nsearch_summary(h, null, null) :=\n  *handle{id: h}.\n\nsearch_candidate(h, span_id, score, reason, field, low_confidence, summary, status, disposition, age_days) :=\n  verb_arg(\"query\", query),\n  search(query, h, span_id, score, reason, field, low_confidence),\n  low_confidence = false,\n  search_summary(h, span_id, summary),\n  *handle{id: h, status: status, date: date},\n  date != null,\n  freshness(h, age_days),\n  hit_currency_disposition(h, disposition).\n\nsearch_candidate(h, span_id, score, reason, field, low_confidence, summary, status, disposition, null) :=\n  verb_arg(\"query\", query),\n  search(query, h, span_id, score, reason, field, low_confidence),\n  low_confidence = false,\n  search_summary(h, span_id, summary),\n  *handle{id: h, status: status, date: null},\n  hit_currency_disposition(h, disposition).\n\nsearch_row(h, span_id, score, reason, field, low_confidence, summary, status, disposition, age_days) :=\n  verb_arg(\"query\", query),\n  verb_arg(\"limit\", limit),\n  (h, span_id, score, reason, field, low_confidence, summary, status, disposition, age_days) = TopK{ k: limit, key: score :\n    (h, span_id, score, reason, field, low_confidence, summary, status, disposition, age_days) :\n      search_candidate(h, span_id, score, reason, field, low_confidence, summary, status, disposition, age_days)\n  }.\n\n? search_row(h, span_id, score, reason, field, low_confidence, summary, status, disposition, age_days).",
  doc: "Search identities, metadata, and content text, returning ranked span-granular hits with reasons, confidence flags, and span summaries.", intents: ["Where does this corpus discuss the text I need?", "Find relevant document sections with scores and match reasons.", "Search content with low confidence matches omitted by default."],
  output_schema: "{\"h\":\"HandleId\",\"span_id\":\"String|null\",\"score\":\"Number\",\"reason\":\"String\",\"field\":\"String\",\"low_confidence\":\"Bool\",\"summary\":\"String|null\",\"status\":\"String|null\",\"disposition\":\"String\",\"age_days\":\"Number|null\"}",
  args: ["query:String", "limit:Int=25"],
  capabilities: ["read"]
).

@verb(
  name: "context",
  query: "context_readable(h) :=\n  verb_arg(\"budget\", per_hit_budget),\n  *handle{id: h},\n  *content{handle: h, tokens}.\n\ncontext_hit_summary(h, span_id, summary) :=\n  *span{handle: h, id: span_id, summary: summary}.\n\ncontext_hit_summary(h, null, null) :=\n  *handle{id: h}.\n\ncontext_candidate(h, hit_span_id, score, reason, field, summary, status, disposition, age_days) :=\n  verb_arg(\"goal\", goal),\n  search(goal, h, hit_span_id, score, reason, field, low_confidence),\n    low_confidence = false,\n  context_readable(h),\n  context_hit_summary(h, hit_span_id, summary),\n  *handle{id: h, status: status, date: date},\n  date != null,\n  freshness(h, age_days),\n  context_currency_disposition(h, disposition).\n\ncontext_candidate(h, hit_span_id, score, reason, field, summary, status, disposition, null) :=\n  verb_arg(\"goal\", goal),\n  search(goal, h, hit_span_id, score, reason, field, low_confidence),\n    low_confidence = false,\n  context_readable(h),\n  context_hit_summary(h, hit_span_id, summary),\n  *handle{id: h, status: status, date: null},\n  context_currency_disposition(h, disposition).\n\ncontext_hit(h, hit_span_id, score, reason, field, summary, status, disposition, age_days) :=\n  verb_arg(\"hits\", hits),\n  (h, hit_span_id, score, reason, field, summary, status, disposition, age_days) = TopK{ k: hits, key: score :\n    (h, hit_span_id, score, reason, field, summary, status, disposition, age_days) :\n      context_candidate(h, hit_span_id, score, reason, field, summary, status, disposition, age_days)\n  }.\n\ncontext_hit_handle(h) := context_hit(h, hit_span_id, score, reason, field, summary, status, disposition, age_days).\n\ncontext_hit_shared_target(h, sibling, target) :=\n  context_hit_handle(h),\n  *edge{from: h, to: target, kind: \"Cites\"},\n  topic_citation_target(target),\n  not topic_nondiscriminative_target(target),\n  not orientation_curated_hub(h),\n  *edge{from: sibling, to: target, kind: \"Cites\"},\n  *handle{id: sibling, kind: \"file\"},\n  sibling != h,\n  not orientation_curated_hub(sibling).\n\ncontext_hit_topic_pair(h, sibling, shared) :=\n  context_hit_handle(h),\n  *handle{id: sibling, kind: \"file\"},\n  sibling != h,\n  not orientation_curated_hub(h),\n  not orientation_curated_hub(sibling),\n  shared = Count{ target : context_hit_shared_target(h, sibling, target) },\n  shared >= 2.\n\ncontext_hit_has_topic_signal(h) :=\n  context_hit_topic_pair(h, sibling, shared).\n\ncontext_hit_topic_signal(h, \"siblings\") := context_hit_has_topic_signal(h).\ncontext_hit_topic_signal(h, \"none\") :=\n  context_hit_handle(h),\n  not context_hit_has_topic_signal(h).\n\ncontext_hit_currency_suspect(h, newer, shared, newer_age_days) :=\n  context_hit_topic_pair(h, newer, shared),\n  authored_age(h, stale_age_days),\n  authored_age(newer, newer_age_days),\n  newer_age_days < stale_age_days,\n  operative(newer),\n  not currency_superseded(h),\n  not currency_superseded(newer).\n\ncontext_hit_newer_topic_sibling_count(h, count) :=\n  context_hit_handle(h),\n  count = Count{ newer : context_hit_currency_suspect(h, newer, shared, age_days) }.\n\ncontext_hit_has_newer_topic_sibling(h) :=\n  context_hit_currency_suspect(h, newer, shared, age_days).\n\ncontext_hit_top_newer_topic_sibling(h, top) :=\n  context_hit_has_newer_topic_sibling(h),\n  (top, shared, age_days) = TopK{ k: 1, key: shared * 100000 - age_days :\n    (top, shared, age_days) :\n      context_hit_currency_suspect(h, top, shared, age_days)\n  }.\n\ncontext_hit_top_newer_topic_sibling(h, null) :=\n  context_hit_handle(h),\n  not context_hit_has_newer_topic_sibling(h).\n\ncontext_neighbor_seed(h, h) := context_hit_handle(h).\ncontext_neighbor_expandable_hit(h) :=\n  context_hit_handle(h),\n  not context_neighbor_hidden(h).\ncontext_neighbor_seed(h, neighbor) :=\n  verb_arg(\"depth\", depth),\n  depth >= 1,\n  context_neighbor_expandable_hit(h),\n  *edge{from: h, to: neighbor}.\ncontext_neighbor_seed(h, neighbor) :=\n  verb_arg(\"depth\", depth),\n  depth >= 1,\n  context_neighbor_expandable_hit(h),\n  *edge{to: h, from: neighbor}.\n\ncontext_file_supersedes(from, to) :=\n  *edge{from: from, to: to, kind: \"Supersedes\"},\n  *handle{id: from, kind: \"file\"},\n  *handle{id: to, kind: \"file\"}.\n\ncontext_currency_superseded(h) := context_file_supersedes(h, newer).\ncontext_currency_successor(h) := context_file_supersedes(older, h).\n\ncontext_currency_disposition(h, \"superseded\") := context_currency_superseded(h).\ncontext_currency_disposition(h, \"current_head\") :=\n  context_currency_successor(h),\n  not context_currency_superseded(h).\ncontext_currency_disposition(h, \"current\") :=\n  *handle{id: h, kind: \"file\"},\n  not context_currency_successor(h),\n  not context_currency_superseded(h).\ncontext_currency_disposition(h, \"unknown\") :=\n  *handle{id: h, kind: kind},\n  kind != \"file\",\n  not context_currency_successor(h),\n  not context_currency_superseded(h).\n\ncontext_neighbor_hidden(neighbor) :=\n  *handle{id: neighbor, file: file},\n  file ends_with \"README.md\".\ncontext_neighbor_hidden(neighbor) :=\n  *handle{id: neighbor, file: file},\n  file ends_with \"INDEX.md\".\ncontext_neighbor_hidden(neighbor) :=\n  *handle{id: neighbor, file: file},\n  file ends_with \"index.md\".\ncontext_neighbor_hidden(neighbor) :=\n  *handle{id: neighbor, file: file},\n  file ends_with \"overview.md\".\ncontext_neighbor_hidden(neighbor) :=\n  *handle{id: neighbor, file: file},\n  file ends_with \"glossary.md\".\ncontext_neighbor_hidden(neighbor) :=\n  *handle{id: neighbor, file: file},\n  file ends_with \"roadmap.md\".\ncontext_neighbor_hidden(neighbor) :=\n  *handle{id: neighbor, file: file},\n  file ends_with \"OPEN-QUESTIONS.md\".\ncontext_neighbor_hidden(neighbor) :=\n  *handle{id: neighbor, file: file},\n  file ends_with \"LABELS.md\".\n\ncontext_neighbor_in_flight(neighbor) := *handle{id: neighbor, status: \"draft\"}.\ncontext_neighbor_in_flight(neighbor) := *handle{id: neighbor, status: \"review\"}.\ncontext_neighbor_in_flight(neighbor) := *handle{id: neighbor, status: \"plan\"}.\ncontext_neighbor_in_flight(neighbor) := *handle{id: neighbor, status: \"exploratory\"}.\ncontext_neighbor_in_flight(neighbor) := *handle{id: neighbor, status: \"raw\"}.\n\ncontext_neighbor_group(neighbor, \"hidden\") := context_neighbor_hidden(neighbor).\n\ncontext_neighbor_group(neighbor, \"superseded\") :=\n  *handle{id: neighbor},\n  context_currency_superseded(neighbor),\n  not context_neighbor_hidden(neighbor).\n\ncontext_neighbor_group(neighbor, \"in_flight\") :=\n  *handle{id: neighbor},\n  context_neighbor_in_flight(neighbor),\n  not context_currency_superseded(neighbor),\n  not context_neighbor_hidden(neighbor).\n\ncontext_neighbor_group(neighbor, \"current\") :=\n  *handle{id: neighbor},\n  not context_currency_superseded(neighbor),\n  not context_neighbor_in_flight(neighbor),\n  not context_neighbor_hidden(neighbor).\n\ncontext_neighbor_age(neighbor, age_days) :=\n  *handle{id: neighbor, date: date},\n  date != null,\n  freshness(neighbor, age_days).\n\ncontext_neighbor_age(neighbor, null) := *handle{id: neighbor, date: null}.\n\ncontext_neighbor_group_score(\"current\", 300).\ncontext_neighbor_group_score(\"in_flight\", 200).\ncontext_neighbor_group_score(\"superseded\", 100).\ncontext_neighbor_group_score(\"hidden\", 0).\n\ncontext_neighbor_disposition_score(\"current_head\", 35).\ncontext_neighbor_disposition_score(\"current\", 20).\ncontext_neighbor_disposition_score(\"superseded\", 0).\ncontext_neighbor_disposition_score(\"unknown\", 0).\n\ncontext_neighbor_disposition_penalty(\"current_head\", 0).\ncontext_neighbor_disposition_penalty(\"current\", 0).\ncontext_neighbor_disposition_penalty(\"superseded\", 40).\ncontext_neighbor_disposition_penalty(\"unknown\", 0).\n\ncontext_neighbor_out_degree_penalty(neighbor, degree, 0) := out_degree(neighbor, degree), degree < 10.\ncontext_neighbor_out_degree_penalty(neighbor, degree, 8) := out_degree(neighbor, degree), degree >= 10, degree < 25.\ncontext_neighbor_out_degree_penalty(neighbor, degree, 16) := out_degree(neighbor, degree), degree >= 25, degree < 50.\ncontext_neighbor_out_degree_penalty(neighbor, degree, 28) := out_degree(neighbor, degree), degree >= 50, degree < 100.\ncontext_neighbor_out_degree_penalty(neighbor, degree, 40) := out_degree(neighbor, degree), degree >= 100, degree < 250.\ncontext_neighbor_out_degree_penalty(neighbor, degree, 55) := out_degree(neighbor, degree), degree >= 250.\n\ncontext_neighbor_candidate(h, neighbor, status, disposition, age_days, degree, group) :=\n  context_neighbor_seed(h, neighbor),\n  *handle{id: neighbor, status: status},\n  context_currency_disposition(neighbor, disposition),\n  context_neighbor_age(neighbor, age_days),\n  out_degree(neighbor, degree),\n  context_neighbor_group(neighbor, group).\n\ncontext_neighbor(h, h, status, disposition, age_days, degree, group) :=\n  context_neighbor_candidate(h, h, status, disposition, age_days, degree, group).\n\ncontext_neighbor(h, neighbor, status, disposition, age_days, degree, group) :=\n  context_hit_handle(h),\n  (neighbor, status, disposition, age_days, degree, group) = TopK{ k: 16, key: group_score + disposition_score - disposition_penalty - degree_penalty :\n    (neighbor, status, disposition, age_days, degree, group) :\n      context_neighbor_candidate(h, neighbor, status, disposition, age_days, degree, group),\n      context_neighbor_group_score(group, group_score),\n      context_neighbor_disposition_score(disposition, disposition_score),\n      context_neighbor_disposition_penalty(disposition, disposition_penalty),\n      context_neighbor_out_degree_penalty(neighbor, degree, degree_penalty),\n      neighbor != h\n  }.\n\ncontext_span(h, hit_span_id, text, start_line, end_line, tokens) :=\n  verb_arg(\"budget\", per_hit_budget),\n  context_hit(h, hit_span_id, score, reason, field, summary, status, disposition, age_days),\n  *span{handle: h, id: hit_span_id},\n  read(h, per_hit_budget, hit_span_id, text, start_line, end_line, tokens).\n\ncontext_span(h, span_id, text, start_line, end_line, tokens) :=\n  verb_arg(\"budget\", per_hit_budget),\n  context_hit(h, null, score, reason, field, summary, status, disposition, age_days),\n  (span_id, text, start_line, end_line, tokens) = TakeUntil{\n    budget: per_hit_budget, sum: tokens, key: start_line :\n    (span_id, text, start_line, end_line, tokens) :\n      read(h, per_hit_budget, span_id, text, start_line, end_line, tokens)\n  }.\n\ncontext_output(\"hit\", h, hit_span_id, score, reason, field, summary, null, null, null, null, null, null, status, disposition, age_days, topic_signal, newer_topic_sibling_count, top_newer_topic_sibling, null, null, null, null, null, null) :=\n  context_hit(h, hit_span_id, score, reason, field, summary, status, disposition, age_days),\n  context_hit_topic_signal(h, topic_signal),\n  context_hit_newer_topic_sibling_count(h, newer_topic_sibling_count),\n  context_hit_top_newer_topic_sibling(h, top_newer_topic_sibling).\n\ncontext_output(\"span\", h, null, null, null, null, null, span_id, text, start_line, end_line, tokens, null, null, null, null, null, null, null, null, null, null, null, null, null) :=\n  context_span(h, span_id, text, start_line, end_line, tokens).\n\ncontext_output(\"neighbor\", h, null, null, null, null, null, null, null, null, null, null, neighbor, null, null, null, null, null, null, neighbor_status, neighbor_disposition, neighbor_age_days, neighbor_in_degree, neighbor_out_degree, neighbor_group) :=\n  context_neighbor(h, neighbor, neighbor_status, neighbor_disposition, neighbor_age_days, neighbor_out_degree, neighbor_group),\n  in_degree(neighbor, neighbor_in_degree).\n\n? context_output(section, h, hit_span_id, score, reason, field, summary, span_id, text, start_line, end_line, tokens, neighbor, status, disposition, age_days, topic_signal, newer_topic_sibling_count, top_newer_topic_sibling, neighbor_status, neighbor_disposition, neighbor_age_days, neighbor_in_degree, neighbor_out_degree, neighbor_group).",
  doc: "Orient a cold agent around a goal: ranked summary-bearing span hits, span metadata, and nearby handles in one call. Neighborhood in_degree and out_degree count incoming and outgoing stored edges of all kinds across the loaded corpus; text shows in and out. Ranking penalizes out_degree only. Use the CLI --read-spans flag to include matched span bodies.", intents: ["What should I read first to work on this goal?", "Gather relevant evidence and nearby dependencies for orientation.", "Retrieve bounded context rather than every matching document."],
  output_schema: "{\"goal\":\"String\",\"hits\":[{\"handle\":\"HandleId\",\"span_id\":\"String|null\",\"score\":\"Number\",\"reason\":\"String\",\"field\":\"String\",\"summary\":\"String|null\",\"status\":\"String|null\",\"disposition\":\"String\",\"age_days\":\"Number|null\",\"topic_signal\":\"String\",\"newer_topic_sibling_count\":\"Number\",\"top_newer_topic_sibling\":\"HandleId|null\"}],\"spans\":[{\"handle\":\"HandleId\",\"span_id\":\"String\",\"start_line\":\"Number\",\"end_line\":\"Number\",\"tokens\":\"Number\",\"text\":\"String|null; present with --read-spans\"}],\"neighborhood\":[{\"handle\":\"HandleId\",\"neighbor\":\"HandleId\",\"status\":\"String|null\",\"disposition\":\"String\",\"age_days\":\"Number|null\",\"in_degree\":\"Number\",\"out_degree\":\"Number\",\"group\":\"String\"}]}",
  args: ["goal:String", "budget:Int=4000", "depth:Int=1", "hits:Int=3"],
  capabilities: ["read"]
).


@verb(
  name: "read",
  query: "read_row(span_id, text, start_line, end_line, tokens, total_tokens) :=\n  verb_arg(\"h\", h),\n  verb_arg(\"budget\", budget),\n  read(h, budget, span_id, text, start_line, end_line, tokens),\n  *content{handle: h, span_id: span_id, tokens: total_tokens}.\n\n? read_row(span_id, text, start_line, end_line, tokens, total_tokens).",
  doc: "Read bounded content spans for one handle without flooding the context window. Use the CLI `--span-id` flag to target one heading span.", intents: ["Show the evidence in this document within my reading budget.", "Read the exact section returned by search.", "Read bounded stored content for one known handle."],
  output_schema: "{\"span_id\":\"String\",\"text\":\"String\",\"start_line\":\"Number\",\"end_line\":\"Number\",\"tokens\":\"Number\",\"total_tokens\":\"Number\"}",
  args: ["h:HandleId", "budget:Int=4000"],
  capabilities: ["read"]
).

@verb(
  name: "schema",
  query: "? schema(name, kind, signature, determinism, provenance).",
  doc: "List everything a Datalog query can call, including stored relations, derived predicates, and engine primitives. The signature column is the argument order and the named-call field set.", intents: ["What names can I call in an Anneal query?", "List runtime vocabulary with argument order and named fields.", "Discover callable signatures rather than searching document content."],
  output_schema: "{\"name\":\"String\",\"kind\":\"String\",\"signature\":\"String\",\"determinism\":\"String\",\"provenance\":\"String\"}",
  args: [],
  capabilities: []
).

@verb(
  name: "predicates",
  query: "? predicates(name, doc, file, lines).",
  doc: "List predicates defined by Datalog rules, with documentation and source locations.", intents: ["Which rules does this project define and where?", "List derived predicates with their documentation and source locations.", "Inspect rule definitions rather than stored relation rows."],
  output_schema: "{\"name\":\"String\",\"doc\":\"String\",\"file\":\"String\",\"lines\":\"String\"}",
  args: [],
  capabilities: []
).

@verb(
  name: "describe",
  query: "describe_row(name, doc) :=\n  verb_arg(\"name\", name),\n  describe(name, doc).\n\n? describe_row(name, doc).",
  doc: "Return the teaching card for a runtime name: summary, kind, signature, requirements, examples, and source when known.", intents: ["How do I use this runtime name correctly?", "Explain the contract and examples for a predicate or command.", "Read teaching cards rather than corpus evidence."],
  output_schema: "{\"name\":\"String\",\"doc\":\"String\"}",
  args: ["name:String"],
  capabilities: []
).

@verb(
  name: "source-of",
  query: "source_of_row(name, file, lines) :=\n  verb_arg(\"name\", name),\n  source_of(name, file, lines).\n\n? source_of_row(name, file, lines).",
  doc: "Return the file and line where a runtime name is defined, when that name comes from a rule, verb, or prelude declaration.", intents: ["Where is this predicate or command defined?", "Find the defining file and line for a runtime name.", "Inspect declaration locations rather than assertion blame."],
  output_schema: "{\"name\":\"String\",\"file\":\"String\",\"lines\":\"String\"}",
  args: ["name:String"],
  capabilities: []
).

@verb(
  name: "intents",
  query: "? card_intents(name, kind, intent) order by kind asc, name asc, intent asc.",
  doc: "Read all authored goal phrasings grouped by teaching card. The reading agent matches goals; this list makes no semantic ranking claim.", intents: ["Which Anneal capability answers the question I have?", "Find the right predicate or command from a goal sentence.", "Read every declared teaching goal before choosing a capability."],
  output_schema: "{\"name\":\"String\",\"kind\":\"String\",\"intent\":\"String\"}",
  args: [],
  capabilities: []
).

@doc(name: "lifecycle_status_classification", doc: "Return each effectively modeled lifecycle status classification and whether project config or a builtin supplied it.", intents: ["What do our statuses mean for active terminal and settled work?", "Inspect effective lifecycle classifications and their origins.", "A settled status does not automatically imply terminality.", "What does this project mean by active and terminal in its effective lifecycle classification?"]).

@doc(name: "repository_operation_capability", doc: "Report whether this workspace can answer each repository-backed operation, with its provider and reason.", intents: ["Can this workspace answer history provenance ignore rules and version tags?", "Explain why a repository-backed operation is unavailable.", "Operation availability is distinct from actor permission and nonempty results.", "What Git operations work in this jj workspace according to the capability probes?"]).

@doc(name: "sources", doc: "List linked adapters with recognition patterns, capabilities, and documentation.", intents: ["Which source adapters are linked and what do they recognize?", "Inspect adapter search and capability declarations.", "List runtime sources rather than discovered corpus files."]).

@doc(name: "source_of", doc: "Return source file and line information for queryable runtime names.", intents: ["Which file and line define this runtime name?", "Join predicate names to declaration locations.", "Definition provenance is distinct from document assertion blame."]).

@doc(name: "git_mtime", doc: "Return the latest Git timestamp observed for a tracked corpus file: committer time in direct Git, selected author time in a pinned jj workspace. Failed direct history probes emit no rows and report change_history unavailable with a reason in repository_operation_capability.", intents: ["When did repository history last change this corpus file?", "Read the history timestamp used for change recency.", "Direct Git uses committer time while pinned jj history uses selected author time."]).

@doc(name: "changed_within", doc: "Return handles whose backing file changed within a bound number of days according to git history.", intents: ["Which handles changed in repository history within this many days?", "Find recently changed backing files.", "Use lower-authority history recency rather than document authored dates."]).

@doc(name: "snapshot", doc: "Runtime-populated historical snapshot facts.", intents: ["What facts were recorded in an earlier corpus observation?", "Inspect saved snapshot identities and timestamps.", "Historical observation rows do not prove current content."]).

@doc(name: "search", doc: "Search handle identities, metadata, headings, and content text, returning ranked span-granular hits with heading ids, reasons, and calibrated scores.", intents: ["How can I query matching content spans with scores and confidence flags?", "Search stored evidence by identifiers headings metadata and body text.", "The primitive returns low-confidence hits before a verb filters them.", "Where was this removed vocabulary used in stored corpus content?"]).

@doc(name: "read", doc: "Read content spans for one handle, optionally narrowed to the exact span_id returned by search or context.", intents: ["How can I compose a bounded read of one known handle?", "Read the exact span identity returned by retrieval.", "A read budget bounds content and does not grant full-read capability."]).

@doc(name: "describe", doc: "Return documentation for a relation, predicate, primitive, verb, source, or runtime topic.", intents: ["How can I query documentation for a runtime capability?", "Retrieve teaching contracts by relation primitive verb source or topic name.", "Same-name cards may have different kinds and contracts."]).

@doc(name: "schema", doc: "List queryable stored relations, derived predicates, and engine primitives. The signature column is both the positional argument order and the accepted named-call parameter set.", intents: ["How do I inspect positional and named query arguments?", "Query callable vocabulary and signatures as structured rows.", "Signatures describe the runtime rather than corpus contents."]).

@doc(name: "active", doc: "Return handles whose status means an agent may still need to read, change, or resolve them.", intents: ["Which handles can still require work under project lifecycle rules?", "Find currently active graph subjects.", "Use the effective active rule rather than a second status heuristic."]).

@doc(name: "terminal", doc: "Return handles whose status means the work is done, archived, rejected, or otherwise no longer active.", intents: ["Which handles are done archived rejected or otherwise inactive?", "Find work classified terminal by the effective lifecycle rules.", "Terminality alone does not decide dependency validity."]).

@doc(name: "settled", doc: "Return handles that the corpus considers resolved enough to use as stable context.", intents: ["Which handles are resolved enough to use as stable context?", "Find settled work under the effective project lifecycle rules.", "Settled and terminal are distinct classifications."]).

@doc(name: "neighborhood", doc: "Find handles near a starting handle within a bounded number of graph hops.", intents: ["Which graph handles are near this starting handle?", "Expand a bounded graph neighborhood for focused inspection.", "Graph distance is not a semantic similarity score."]).

@doc(name: "E001", doc: "Broken reference: a corpus edge points at a handle that does not exist.", intents: ["Why does a missing reference cause an error?", "Explain broken-reference evidence and how to locate the source.", "Section placeholders are counted separately from broken handles."]).

@doc(name: "E002", doc: "Undischarged obligation: a live obligation handle has no Discharges edge.", intents: ["Why is an outstanding obligation an error?", "Explain a live promise with no discharge evidence.", "Only configured obligation namespaces participate in this check."]).

@doc(name: "E003", doc: "Project diagnostic contract failure: a producer emitted an invalid or undeclared code, or a severity different from its declaration.", intents: ["Why did a project diagnostic produce a contract error?", "Explain an undeclared code or incorrect producer severity.", "Contract failures are reported even when the offending project observation cannot be accepted."]).

@doc(name: "I001", doc: "Section references present: section-reference placeholders exist and are counted separately from broken handles.", intents: ["What does the section-reference information count mean?", "Explain placeholder references to document sections.", "A section count does not establish that every destination section exists."]).

@doc(name: "I002", doc: "Multiple discharges: a live obligation has more than one Discharges edge.", intents: ["What does the multiple-discharge information message mean?", "Explain redundant evidence attached to an obligation.", "Multiple discharges are information rather than an automatic error."]).

@doc(name: "S001", doc: "Orphaned handle: the subject is a label or version handle with no incoming references. The file is its declaring file, not a claim that the document is orphaned.", intents: ["Why is this label or version suggested for cleanup?", "Explain a handle with no incoming references.", "The declaring file is not itself being called orphaned."]).

@doc(name: "S003", doc: "Pipeline stall: snapshot history shows a lifecycle status accumulating without movement to the next configured status.", intents: ["Why does Anneal suggest that a pipeline is stalled?", "Explain a lifecycle population that is not moving across snapshots.", "A stall suggestion requires automatic observation history."]).

@doc(name: "S004", doc: "Abandoned namespace: an active namespace's members are all terminal or stale.", intents: ["Why does Anneal suggest abandoning a namespace?", "Explain an active namespace with only stale or terminal members.", "Namespace abandonment is a suggestion rather than automatic deletion."]).

@doc(name: "S005", doc: "Concern-group candidate: two label namespaces frequently co-occur and may deserve a configured concern group.", intents: ["Why are these label prefixes suggested as a concern group?", "Explain frequent namespace co-occurrence.", "The suggestion does not establish semantic equivalence."]).

@doc(name: "S006", doc: "Dependency config gap: a terminal status is not classified as dead or valid for dependency checks.", intents: ["Why is dependency configuration missing for a terminal status?", "Explain a suggestion to classify dependencies as dead or valid.", "The evidence counts distinct direct active dependents including zero."]).

@doc(name: "W001", doc: "Stale reference: an active handle depends on a terminal target whose status is classified dead.", intents: ["Why is a dependency reported as stale?", "Explain active work pointing at a terminal target classified dead.", "A terminal target classified valid does not trigger this warning."]).

@doc(name: "W002", doc: "Confidence gap: a dependency target is behind its source in the configured lifecycle order.", intents: ["Why does this dependency have a confidence-gap warning?", "Explain a source more than one configured lifecycle step ahead.", "Lifecycle distance is distinct from document age."]).

@doc(name: "W003", doc: "Missing frontmatter: a file lacks status frontmatter in a directory where frontmatter is otherwise established.", intents: ["Why is missing status frontmatter a warning here?", "Explain inconsistent status adoption in a directory.", "Sparse frontmatter usage alone does not trigger the warning."]).

@doc(name: "W004", doc: "Implausible reference: markdown extraction saw a reference-like token that was rejected as implausible.", intents: ["Why was a reference token considered implausible?", "Explain rejected Markdown link candidates.", "The warning reports extraction evidence rather than a stored broken edge."]).

@doc(name: "W005", doc: "Lifecycle config gap: a status appears in handles or ordering without an effective builtin or project classification, or the ordering cannot terminate.", intents: ["Why is lifecycle configuration reported as incomplete?", "Explain unclassified statuses and orderings that cannot terminate.", "Project overrides and builtin classifications both count as modeling."]).

@doc(name: "W006", doc: "Spec-code drift: a spec that asserts current code cites a path that existed in HEAD history but is now missing on disk.", intents: ["Why does a specification have a code-drift warning?", "Explain a current-code claim whose cited historical path is missing now.", "This warning detects disappeared paths rather than arbitrary code changes."]).

@doc(name: "W007", doc: "Frontmatter mapping gap: an exact reference-like markdown key appears on one or more handles but has no configured edge mapping.", intents: ["Why is a frontmatter reference key missing an edge mapping?", "Explain an exact conventional alias that the project has not modeled.", "The warning does not infer mappings for arbitrary keys."]).

@doc(name: "W008", doc: "Unmodeled frontmatter shape: an authored key contains a mapping that the scalar metadata projection does not represent. A rule claiming authorial absence over *meta must also consult this evidence.", intents: ["Why does nested frontmatter produce a shape warning?", "Explain an authored mapping absent from scalar metadata.", "Missing scalar rows do not prove the author made no assertion."]).
