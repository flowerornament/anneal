diagnostic("W002", effective, subject, file, line, evidence) :=
  builtin_diagnostic("W002", declared, subject, file, line, evidence),
  diagnostic_policy("W002", declared, effective, origin).

diagnostic("W003", effective, subject, file, line, evidence) :=
  builtin_diagnostic("W003", declared, subject, file, line, evidence),
  diagnostic_policy("W003", declared, effective, origin).

diagnostic("W004", effective, subject, file, line, evidence) :=
  builtin_diagnostic("W004", declared, subject, file, line, evidence),
  diagnostic_policy("W004", declared, effective, origin).

diagnostic("W005", effective, subject, file, line, evidence) :=
  builtin_diagnostic("W005", declared, subject, file, line, evidence),
  diagnostic_policy("W005", declared, effective, origin).

diagnostic("W006", effective, subject, file, line, evidence) :=
  builtin_diagnostic("W006", declared, subject, file, line, evidence),
  diagnostic_policy("W006", declared, effective, origin).

diagnostic("W007", effective, subject, file, line, evidence) :=
  builtin_diagnostic("W007", declared, subject, file, line, evidence),
  diagnostic_policy("W007", declared, effective, origin).

diagnostic("W008", effective, subject, file, line, evidence) :=
  builtin_diagnostic("W008", declared, subject, file, line, evidence),
