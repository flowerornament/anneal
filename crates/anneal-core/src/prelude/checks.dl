@predicate(name: "diagnostic_declaration", args: ["code", "declared_severity", "config_key"], shadow: "forbid").
diagnostic_declaration(code, severity, key) := builtin_diagnostic_policy(code, severity, key).
diagnostic_declaration(code, severity, key) := project_diagnostic_declaration(code, severity, key, _).

@doc(name: "project_diagnostic", doc: "Contribute project diagnostic rows under P followed by digits, with mandatory @diagnostic(code, severity, doc, rule, evidence) teaching metadata. Rows use declared severity; policy promotes them and exact subject suppression accepts instances. Invalid or undeclared dynamic codes and severity mismatches emit E003 naming the producing clause. Search returns matching spans, including ancestors: Herald NothingToBless has four spans for two occurrences; a deepest-matching-span filter selects the two children. This is span selection, not occurrence counting: when both parent prose and child match, it drops the parent's own occurrence. Keep handle and term equal in descendant comparisons; require strict prefix plus line containment.", intents: ["How can a project contribute its own consistency checks?", "Emit declared project observations through the generic diagnostic rule.", "Require teaching metadata and matching severity for every project code.", "How can we add our own checks for retired vocabulary using declared project diagnostics?"]).
@predicate(name: "project_diagnostic", args: ["code", "severity", "subject", "file", "line", "evidence"]).
@predicate(name: "project_diagnostic_producer", args: ["code", "severity", "subject", "file", "line", "evidence", "producer"], shadow: "forbid").
@predicate(name: "project_diagnostic_declaration", args: ["code", "severity", "escalation_key", "suppression_key"], shadow: "forbid").
@predicate(name: "validated_project_diagnostic", args: ["code", "severity", "subject", "file", "line", "evidence"], shadow: "forbid").
@predicate(name: "project_diagnostic_contract_failure", args: ["subject", "file", "line", "evidence"], shadow: "forbid").
project_diagnostic(code, severity, subject, file, line, evidence) :=
  project_diagnostic_producer(code, severity, subject, file, line, evidence, _).
validated_project_diagnostic(code, effective, subject, file, line, evidence) :=
  project_diagnostic_producer(code, declared, subject, file, line, evidence, _),
  project_diagnostic_declaration(code, declared, _, suppression_key),
  diagnostic_policy(code, declared, effective, _),
  not diagnostic_subject_suppressed(suppression_key, subject).
@doc(name: "project_diagnostic_contract_failure", doc: "Rule-defined predicate project_diagnostic_contract_failure.", intents: ["Why did my custom diagnostic fail its declaration contract?", "Find undeclared project codes and severity mismatches.", "Report producer contract failures rather than hiding invalid observations."]). project_diagnostic_contract_failure(subject, file, line, ("invalid_or_undeclared_code", producer, code)) :=
  project_diagnostic_producer(code, _, subject, file, line, _, producer),
  not project_diagnostic_declaration(code, _, _, _).
project_diagnostic_contract_failure(subject, file, line, ("severity_mismatch", producer, code, actual, declared)) :=
  project_diagnostic_producer(code, actual, subject, file, line, _, producer),
  project_diagnostic_declaration(code, declared, _, _),
  actual != declared.
builtin_diagnostic("E003", "error", subject, file, line, evidence) :=
  project_diagnostic_contract_failure(subject, file, line, evidence),
  not diagnostic_subject_suppressed("suppress.rule.E003", subject).
diagnostic("E003", effective, subject, file, line, evidence) :=
  builtin_diagnostic("E003", declared, subject, file, line, evidence),
  diagnostic_policy("E003", declared, effective, _).
# The only trusted dynamic diagnostic head: projects cannot replace either relation.
diagnostic(code, severity, subject, file, line, evidence) :=
  validated_project_diagnostic(code, severity, subject, file, line, evidence).

@doc(
  name: "suppress",
  doc: "Accept an individual diagnostic with config suppress { rule(CODE, target). }. The target matches the diagnostic subject identity exactly: file paths for file subjects, and the status, namespace or corpus identity for aggregate subjects. It never matches referenced evidence targets, file locations or globs. The underlying finding remains queryable. Blanket suppress.code declarations refuse at load; use rule(CODE, target) per instance."
).

@doc(
  name: "diagnostic_subject_suppressed",
  doc: "Return subjects accepted by an exact config key such as suppress.rule.E001. Diagnostic producers bind their own full key; this gate helper cannot be replaced by project rules."
).
@predicate(
  name: "diagnostic_subject_suppressed",
  args: ["config_key", "subject"],
  shadow: "forbid"
).
diagnostic_subject_suppressed(config_key, subject) :=
  *config{key: config_key, value: subject}.

section_ref(target) :=
  *edge{to: target},
  target starts_with "section:".

@doc(
  name: "broken_reference",
  doc: "Return references whose target handle does not exist, excluding section-reference placeholders.", intents: ["Which document references point to missing handles?", "Find dangling links that need repair.", "Exclude section placeholders from missing handle errors."]
).
@predicate(
  name: "broken_reference",
  args: ["src", "target", "file", "line"]
).
broken_reference(src, target, file, line) :=
  *edge{from: src, to: target, file: file, line: line},
  not *handle{id: target},
  not section_ref(target).

builtin_diagnostic("E001", "error", src, file, line, ("broken_ref", target)) :=
  broken_reference(src, target, file, line),
  not diagnostic_subject_suppressed("suppress.rule.E001", src).

section_ref_edge(edge_id) :=
  *edge{native_id: edge_id, to: target},
  section_ref(target).

@doc(name: "section_ref_total", doc: "Rule-defined predicate section_ref_total.", intents: ["How many section-reference placeholders does this corpus contain?", "Count section references separately from broken links.", "Count stored reference edges rather than validating section contents."]). section_ref_total(count) :=
  count = Count{ edge_id : section_ref_edge(edge_id) },
  count > 0.

builtin_diagnostic("I001", "info", "corpus", null, null, ("section_refs", count)) :=
  section_ref_total(count),
  not diagnostic_subject_suppressed("suppress.rule.I001", "corpus").

@doc(
  name: "implausible_ref",
  doc: "Return body references that were detected but rejected as implausible links.", intents: ["Which reference tokens did the Markdown adapter reject?", "Inspect link candidates that failed the plausibility filter.", "Report extraction evidence rather than inventing broken edges."]
).
@predicate(
  name: "implausible_ref",
  args: ["h", "file", "value"]
).
implausible_ref(h, file, value) :=
  *meta{handle: h, key: "md.implausible_ref", value: value},
  *handle{id: h, file: file}.

builtin_diagnostic("W004", "warning", h, file, null, ("implausible_ref", value)) :=
  implausible_ref(h, file, value),
  not diagnostic_subject_suppressed("suppress.rule.W004", h).

@doc(
  name: "unmodeled_frontmatter_shape",
  doc: "Return authored frontmatter keys containing mappings omitted by the scalar metadata projection. Evidence is JSON with key, shape, line and line_exact. A rule claiming authorial absence over *meta must also consult this evidence; no scalar row does not mean no assertion.", intents: ["Did nested frontmatter contain an assertion that scalar metadata dropped?", "Find mapping-valued keys omitted from scalar projection.", "Consult shape evidence before claiming an authored key is absent."]
).
@predicate(
  name: "unmodeled_frontmatter_shape",
  args: ["h", "file", "evidence"]
).
unmodeled_frontmatter_shape(h, file, evidence) :=
  *meta{handle: h, key: "md.unmodeled_frontmatter_shape", value: evidence, role: "derived", corpus: corpus, source: source},
  *handle{id: h, file: file, corpus: corpus, source: source}.

builtin_diagnostic("W008", "warning", h, file, null, ("unmodeled_frontmatter_shape", evidence)) :=
  unmodeled_frontmatter_shape(h, file, evidence),
  not diagnostic_subject_suppressed("suppress.rule.W008", h).

@doc(
  name: "stale_reference",
  doc: "Return active handles that depend on terminal handles whose status is classified as dead for dependency validity.", intents: ["Which active work depends on a dead completed target?", "Find dependencies that are no longer valid.", "Warn only when the terminal target status is classified dead.", "Are any requirements still relying on a retired decision whose terminal status is classified dead?"]
).
@predicate(
  name: "stale_reference",
  args: ["src", "target", "file", "source_status", "target_status"]
).
stale_reference(src, target, file, source_status, target_status) :=
  *edge{from: src, to: target, kind: "DependsOn"},
  *handle{id: src, status: source_status, file: file},
  *handle{id: target, status: target_status},
  source_status != null,
  active(src),
  terminal(target),
  dependency_dead_status(target_status).

builtin_diagnostic("W001", "warning", src, file, null, ("stale_ref", source_status, target_status)) :=
  stale_reference(src, target, file, source_status, target_status),
  not diagnostic_subject_suppressed("suppress.rule.W001", src).

builtin_dependency_dead_status("superseded").
builtin_dependency_dead_status("retired").
builtin_dependency_dead_status("archived").
builtin_dependency_dead_status("historical").
builtin_dependency_dead_status("deprecated").

builtin_dependency_valid_status("authoritative").
builtin_dependency_valid_status("complete").
builtin_dependency_valid_status("decided").
builtin_dependency_valid_status("stable").
builtin_dependency_valid_status("ratified").

configured_dependency_dead_status(status) :=
  *config{key: "dependency.dead", value: status}.

configured_dependency_valid_status(status) :=
  *config{key: "dependency.valid", value: status}.

configured_dependency_status(status) := configured_dependency_dead_status(status).
configured_dependency_status(status) := configured_dependency_valid_status(status).

@doc(
  name: "dependency_status_classification",
  doc: "Return each effective dependency-validity status classification and whether it came from a project override or the conservative builtin set.", intents: ["What counts as a valid or dead dependency in this project?", "Inspect effective dependency policy and its project or builtin origin.", "Classify dependency validity rather than universal normativity.", "How do I model normativity for dependency statuses?"]
).
@predicate(
  name: "dependency_status_classification",
  args: ["status", "classification", "origin"]
).
dependency_status_classification(status, "dead", "project") :=
  configured_dependency_dead_status(status).

dependency_status_classification(status, "valid", "project") :=
  configured_dependency_valid_status(status).

dependency_status_classification(status, "dead", "builtin") :=
  builtin_dependency_dead_status(status),
  not configured_dependency_status(status).

dependency_status_classification(status, "valid", "builtin") :=
  builtin_dependency_valid_status(status),
  not configured_dependency_status(status).

@doc(
  name: "dependency_dead_status",
  doc: "Return effective statuses whose terminal handles are dead dependency targets. Project classification overrides the builtin meaning per status."
).
@predicate(
  name: "dependency_dead_status",
  args: ["status"]
).
dependency_dead_status(status) :=
  dependency_status_classification(status, "dead", origin).

@doc(
  name: "dependency_valid_status",
  doc: "Return effective statuses whose terminal handles remain valid dependency targets. Project classification overrides the builtin meaning per status."
).
@predicate(
  name: "dependency_valid_status",
  args: ["status"]
).
dependency_valid_status(status) :=
  dependency_status_classification(status, "valid", origin).

@doc(
  name: "spec_code_drift",
  doc: "Return live spec files that cite code paths the extractor could confidently resolve as missing on disk.", intents: ["Which specifications still cite code paths that have disappeared?", "Find claims about current code whose cited files are missing.", "Check historical existence and current path absence rather than arbitrary code edits.", "Which specs cite code that has changed by disappearing from its historically existing path?"]
).
@predicate(
  name: "spec_code_drift",
  args: ["src", "target_path", "file", "line", "source_status"]
).
spec_code_drift(src, target_path, file, line, source_status) :=
  *edge{from: src, to: ref, kind: "Cites", file: file, line: line},
  *handle{id: src, kind: "file", status: source_status},
  asserts_code(source_status),
  *handle{id: ref, kind: "external"},
  *meta{handle: ref, key: "external_class", value: "code"},
  *meta{handle: ref, key: "target_exists", value: "false"},
  *meta{handle: ref, key: "target_path", value: target_path},
  not referent_drift_evidence_present(ref).

referent_drift_evidence_present(ref) := referent_disposition(ref, disposition).

referent_warning_disposition("referent-gone").
referent_warning_disposition("referent-moved-ambiguous").

spec_code_drift(src, target_path, file, line, source_status) :=
  *edge{from: src, to: ref, kind: "Cites", file: file, line: line},
  *handle{id: src, kind: "file", status: source_status},
  asserts_code(source_status),
  *handle{id: ref, kind: "external"},
  *meta{handle: ref, key: "external_class", value: "code"},
  *meta{handle: ref, key: "target_path", value: target_path},
  referent_disposition(ref, disposition),
  referent_warning_disposition(disposition).

builtin_diagnostic("W006", "warning", src, file, line, ("spec_code_drift", target_path, source_status)) :=
  spec_code_drift(src, target_path, file, line, source_status),
  not diagnostic_subject_suppressed("suppress.rule.W006", src).

@doc(
  name: "referent_disposition",
  doc: "Return drift disposition evidence for an external code referent. Rows are extraction-time git evidence, or absent when drift evidence has not been refreshed."
).
@predicate(
  name: "referent_disposition",
  args: ["target", "disposition"]
).
referent_disposition(target, disposition) :=
  *meta{handle: target, key: "code.referent_disposition", value: disposition}.

@doc(
  name: "assertion_drift",
  doc: "Return commit-count drift evidence for a design-to-code citation when the referent exists and the assertion-time oracle was available."
).
@predicate(
  name: "assertion_drift",
  args: ["spec", "target", "commits"]
).
assertion_drift(spec, target, commits) :=
  *edge{from: spec, to: target, kind: "Cites"},
  *meta{handle: target, key: "code.referent_commits_since", value: commits}.

@doc(
  name: "referent_moved_head",
  doc: "Return confident single-head move evidence for an external code referent. Ambiguous fanout remains in referent_disposition plus move-candidate metadata."
).
@predicate(
  name: "referent_moved_head",
  args: ["target", "new_path"]
).
referent_moved_head(target, new_path) :=
  *meta{handle: target, key: "code.referent_moved_to", value: new_path}.

@doc(
  name: "drift_profile",
  doc: "Aggregate design-to-code referent drift dispositions for arrival/status surfaces."
).
@predicate(
  name: "drift_profile",
  args: ["bucket", "count"]
).
drift_profile(bucket, count) :=
  referent_disposition(sample, bucket),
  count = Count{ target : referent_disposition(target, bucket) }.

@doc(
  name: "code_ref",
  doc: "Resolve markdown code citations to code-source file handles when both sources are loaded. The citation edge points to a qualified external handle; target_path metadata carries the resolvable path."
).
@predicate(
  name: "code_ref",
  args: ["spec", "ref", "path", "code_handle", "disposition"]
).
code_ref(spec, ref, path, code_handle, disposition) :=
  *edge{from: spec, to: ref, kind: "Cites", source: "markdown"},
  *handle{id: ref, kind: "external", source: "markdown"},
  *meta{handle: ref, key: "external_class", value: "code"},
  *meta{handle: ref, key: "target_path", value: path},
  *handle{id: code_handle, kind: "file", source: "code", file: file},
  path_resolves(ref, path, file),
  referent_disposition(ref, disposition).

path_resolves(ref, path, file) :=
  *meta{handle: ref, key: "external_class", value: "code"},
  *meta{handle: ref, key: "target_path", value: path},
  *handle{kind: "file", source: "code", file: file},
  path = file.

path_resolves(ref, path, file) :=
  *meta{handle: ref, key: "target_path", value: path},
  *meta{handle: ref, key: "target_resolved_path", value: resolved_path},
  *handle{kind: "file", source: "code", file: file},
  resolved_path ends_with file.

configured_pipeline_status(status, level) :=
  *config{key: "convergence.ordering", value: status, ordinal: level},
  level != null.

configured_active_status(status) :=
  *config{key: "convergence.active", value: status}.

configured_terminal_status(status) :=
  *config{key: "convergence.terminal", value: status}.

configured_asserts_code_status(status) :=
  *config{key: "convergence.asserts_code", value: status}.

configured_asserts_code_present("yes") :=
  configured_asserts_code_status(status).

@doc(name: "aspirational_code_status", doc: "Rule-defined predicate aspirational_code_status.", intents: ["Which planning statuses are excluded from current-code assertions?", "Identify research and exploratory lifecycle values.", "Inspect the conservative aspirational status set rather than all active work."]). aspirational_code_status("plan").
aspirational_code_status("research").
aspirational_code_status("reference").
aspirational_code_status("exploratory").

@doc(
  name: "asserts_code",
  doc: "Return lifecycle statuses that claim facts about this corpus's current code and should participate in spec-code drift checks.", intents: ["Which statuses claim that a specification describes current code?", "Determine whether a lifecycle status participates in code drift checks.", "Separate current implementation claims from aspirational plans.", "Which designs promise what the software does today rather than a future idea, according to their lifecycle status?"]
).
@predicate(
  name: "asserts_code",
  args: ["status"]
).
asserts_code(status) :=
  configured_asserts_code_status(status).

asserts_code(status) :=
  *handle{id: h, status: status},
  status != null,
  active(h),
  not aspirational_code_status(status),
  not configured_asserts_code_present("yes").

configured_lifecycle_status(status) := configured_active_status(status).
configured_lifecycle_status(status) :=
  *config{key: "convergence.settled", value: status}.
configured_lifecycle_status(status) := configured_terminal_status(status).

modeled_lifecycle_status(status) :=
  lifecycle_status_classification(status, classification, origin).

modeled_terminal_status(status) :=
  lifecycle_status_classification(status, "terminal", origin).

used_lifecycle_status(status) :=
  *handle{status: status},
  status != null.

lifecycle_status_candidate(status) :=
  used_lifecycle_status(status).

lifecycle_status_candidate(status) :=
  configured_pipeline_status(status, level).

status_handle_count(status, count) :=
  lifecycle_status_candidate(status),
  count = Count{ h : *handle{id: h, status: status} }.

max_pipeline_level(level) :=
  level = Max{ l : configured_pipeline_status(status, l) }.

max_pipeline_status(status) :=
  max_pipeline_level(level),
  configured_pipeline_status(status, level).

@doc(
  name: "lifecycle_config_gap",
  doc: "Return lifecycle statuses that corpus data or ordering config use without an effective builtin or project classification, plus orderings that cannot terminate.", intents: ["Which status values does our lifecycle policy fail to model?", "Find unknown lifecycle vocabulary or an ordering that cannot terminate.", "Check effective project and builtin classifications together."]
).
@predicate(
  name: "lifecycle_config_gap",
  args: ["status", "count", "variant"]
).
lifecycle_config_gap(status, count, "used_status_unpartitioned") :=
  used_lifecycle_status(status),
  status_handle_count(status, count),
  not modeled_lifecycle_status(status).

lifecycle_config_gap(status, count, "ordering_status_unpartitioned") :=
  configured_pipeline_status(status, level),
  status_handle_count(status, count),
  not modeled_lifecycle_status(status).

lifecycle_config_gap(status, count, "ordering_not_terminal") :=
  max_pipeline_status(status),
  status_handle_count(status, count),
  not modeled_terminal_status(status).

builtin_diagnostic("W005", "warning", status, null, null, ("lifecycle_config_gap", status, count, variant)) :=
  lifecycle_config_gap(status, count, variant),
  not diagnostic_subject_suppressed("suppress.rule.W005", status).

