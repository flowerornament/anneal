).
@predicate(
  name: "builtin_diagnostic",
  args: ["code", "declared_severity", "subject", "file", "line", "evidence"],
  shadow: "forbid"
).
diagnostic("E001", effective, subject, file, line, evidence) :=
  builtin_diagnostic("E001", declared, subject, file, line, evidence),
  diagnostic_policy("E001", declared, effective, origin).

diagnostic("E002", effective, subject, file, line, evidence) :=
  builtin_diagnostic("E002", declared, subject, file, line, evidence),
  diagnostic_policy("E002", declared, effective, origin).

diagnostic("I001", effective, subject, file, line, evidence) :=
  builtin_diagnostic("I001", declared, subject, file, line, evidence),
  diagnostic_policy("I001", declared, effective, origin).

diagnostic("I002", effective, subject, file, line, evidence) :=
  builtin_diagnostic("I002", declared, subject, file, line, evidence),
  diagnostic_policy("I002", declared, effective, origin).

diagnostic("S001", effective, subject, file, line, evidence) :=
  builtin_diagnostic("S001", declared, subject, file, line, evidence),
  diagnostic_policy("S001", declared, effective, origin).

diagnostic("S003", effective, subject, file, line, evidence) :=
  builtin_diagnostic("S003", declared, subject, file, line, evidence),
  diagnostic_policy("S003", declared, effective, origin).

diagnostic("S004", effective, subject, file, line, evidence) :=
  builtin_diagnostic("S004", declared, subject, file, line, evidence),
  diagnostic_policy("S004", declared, effective, origin).

diagnostic("S005", effective, subject, file, line, evidence) :=
  builtin_diagnostic("S005", declared, subject, file, line, evidence),
  diagnostic_policy("S005", declared, effective, origin).

diagnostic("S006", effective, subject, file, line, evidence) :=
  builtin_diagnostic("S006", declared, subject, file, line, evidence),
  diagnostic_policy("S006", declared, effective, origin).

diagnostic("W001", effective, subject, file, line, evidence) :=
  builtin_diagnostic("W001", declared, subject, file, line, evidence),
