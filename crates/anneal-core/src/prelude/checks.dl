# Source-backed topic documentation for standard diagnostics.

@doc(
  name: "checks",
  doc: "Diagnostic rules find corpus problems agents can act on: broken references, unfinished obligations, stale dependencies, confidence gaps, convention drift, and maintenance suggestions."
).

@doc(
  name: "diagnostic",
  doc: "Return every standard and declared project diagnostic as data: code, effective severity, subject handle, location, and evidence. Commands render these rows as errors, warnings, suggestions, and explanations. This gate-output relation cannot be shadowed from anneal.dl because replacing it could make a broken corpus pass anneal check; contribute project observations through project_diagnostic/6 with @diagnostic teaching metadata.", intents: ["What errors warnings suggestions and explanations does the corpus emit?", "Inspect effective diagnostic severity subjects locations and evidence.", "Use the sealed diagnostic stream rather than replacing the gate with a project rule."]
).

@predicate(
  name: "diagnostic",
  args: ["code", "severity", "subject", "file", "line", "evidence"],
  shadow: "forbid"
).

@doc(
  name: "builtin_diagnostic_policy",
  doc: "Return the declared builtin diagnostic class and its exact escalation config key. This catalog is sealed because it supplies the check process result."
).
@predicate(
  name: "builtin_diagnostic_policy",
  args: ["code", "declared_severity", "config_key"],
  shadow: "forbid"
).
builtin_diagnostic_policy("E001", "error", "diagnostics.escalate.E001").
builtin_diagnostic_policy("E002", "error", "diagnostics.escalate.E002").
builtin_diagnostic_policy("E003", "error", "diagnostics.escalate.E003").
builtin_diagnostic_policy("I001", "info", "diagnostics.escalate.I001").
builtin_diagnostic_policy("I002", "info", "diagnostics.escalate.I002").
builtin_diagnostic_policy("S001", "suggestion", "diagnostics.escalate.S001").
builtin_diagnostic_policy("S003", "suggestion", "diagnostics.escalate.S003").
builtin_diagnostic_policy("S004", "suggestion", "diagnostics.escalate.S004").
builtin_diagnostic_policy("S005", "suggestion", "diagnostics.escalate.S005").
builtin_diagnostic_policy("S006", "suggestion", "diagnostics.escalate.S006").
builtin_diagnostic_policy("W001", "warning", "diagnostics.escalate.W001").
builtin_diagnostic_policy("W002", "warning", "diagnostics.escalate.W002").
builtin_diagnostic_policy("W003", "warning", "diagnostics.escalate.W003").
builtin_diagnostic_policy("W004", "warning", "diagnostics.escalate.W004").
builtin_diagnostic_policy("W005", "warning", "diagnostics.escalate.W005").
builtin_diagnostic_policy("W006", "warning", "diagnostics.escalate.W006").
builtin_diagnostic_policy("W007", "warning", "diagnostics.escalate.W007").
builtin_diagnostic_policy("W008", "warning", "diagnostics.escalate.W008").

@doc(
  name: "diagnostic_severity_promotion",
  doc: "Return allowed upward diagnostic class promotions. Info and suggestion each promote to warning or error; they never convert into each other."
).
@predicate(
  name: "diagnostic_severity_promotion",
  args: ["declared_severity", "effective_severity"],
  shadow: "forbid"
).
diagnostic_severity_promotion("info", "warning").
diagnostic_severity_promotion("info", "error").
diagnostic_severity_promotion("suggestion", "warning").
diagnostic_severity_promotion("suggestion", "error").
diagnostic_severity_promotion("warning", "error").

@doc(
  name: "project_diagnostic_escalation",
  doc: "Return actual configured promotions, excluding equal-severity no-ops."
).
@predicate(
  name: "project_diagnostic_escalation",
  args: ["code", "declared_severity", "effective_severity"],
  shadow: "forbid"
).
project_diagnostic_escalation(code, declared, effective) :=
  diagnostic_declaration(code, declared, key),
  *config{key: key, value: effective},
  diagnostic_severity_promotion(declared, effective).

@doc(
  name: "diagnostics",
  doc: "Configure declared diagnostic grading with config diagnostics { escalate(CODE, SEVERITY). }. Only upward promotions are allowed; identical repeats and equal grades are stdlib no-ops. Query diagnostic_policy for declared and effective classes and origin, and describe CODE for the effective teaching card. Unknown codes/classes, downgrades and conflicting grades refuse at load. Acceptance remains per subject instance through config suppress."
).

@doc(
  name: "diagnostic_policy",
  doc: "Return the effective diagnostic grading for every builtin and declared project code, even when no instance is emitted. Origin is project only for an actual promotion; equal-severity declarations are accepted stdlib no-ops. Config diagnostics escalate(CODE, SEVERITY) permits upward re-grading only; unknown codes, classes, downgrades and conflicting declarations refuse at load. Instance suppression does not remove policy rows.", intents: ["How are diagnostic codes graded in this project?", "Inspect declared codes even when no instance was emitted.", "Equal severity declarations remain builtin no-ops and suppression keeps policy rows.", "Can the project turn warnings into errors through explicit severity promotion?"]
).
@predicate(
  name: "diagnostic_policy",
  args: ["code", "declared_severity", "effective_severity", "origin"],
  shadow: "forbid"
).
diagnostic_policy(code, declared, effective, "project") :=
  project_diagnostic_escalation(code, declared, effective).
diagnostic_policy(code, declared, declared, "stdlib") :=
  diagnostic_declaration(code, declared, key),
  not project_diagnostic_escalation(code, declared, _).

