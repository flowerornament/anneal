frontmatter_unmapped_alias_use(key, h) :=
  frontmatter_mapping_alias(key, suggested_field, edge_kind, direction),
  *meta{handle: h, key: key, value: value, role: "authored_unmodeled"},
  *meta{handle: h, key: "md.parent_dir", value: parent_dir},
  not configured_frontmatter_alias(key),
  not frontmatter_intentionally_unmapped(key).

@doc(
  name: "frontmatter_mapping_gap",
  doc: "Return exact reference-like markdown frontmatter aliases that have no configured edge mapping, aggregated by distinct file handle, with the conventional field, edge kind, and direction to configure.", intents: ["Which reference-like frontmatter keys need an edge mapping?", "Find conventional aliases that the project has not modeled.", "Suggest mappings only for the finite exact alias vocabulary."]
).
