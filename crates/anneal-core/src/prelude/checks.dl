# Source-backed topic documentation for standard diagnostics.

@doc(
  name: "checks",
  doc: "Diagnostic rules find corpus problems agents can act on: broken references, unfinished obligations, stale dependencies, confidence gaps, convention drift, and maintenance suggestions."
).

@doc(
  name: "diagnostic",
  doc: "Return every standard diagnostic as data: code, severity, subject handle, location, and evidence. Commands render these rows as errors, warnings, suggestions, and explanations."
).

@predicate(
  name: "diagnostic",
  args: ["code", "severity", "subject", "file", "line", "evidence"]
).

section_ref(target) :=
  *edge{to: target},
  target starts_with "section:".

@doc(
  name: "broken_reference",
  doc: "Return references whose target handle does not exist, excluding section-reference placeholders."
).
@predicate(
  name: "broken_reference",
  args: ["src", "target", "file", "line"]
).
broken_reference(src, target, file, line) :=
  *edge{from: src, to: target, file: file, line: line},
  not *handle{id: target},
  not section_ref(target).

diagnostic("E001", "error", src, file, line, ("broken_ref", target)) :=
  broken_reference(src, target, file, line).

section_ref_edge(edge_id) :=
  *edge{native_id: edge_id, to: target},
  section_ref(target).

section_ref_total(count) :=
  count = Count{ edge_id : section_ref_edge(edge_id) },
  count > 0.

diagnostic("I001", "info", "corpus", null, null, ("section_refs", count)) :=
  section_ref_total(count).

@doc(
  name: "implausible_ref",
  doc: "Return body references that were detected but rejected as implausible links."
).
@predicate(
  name: "implausible_ref",
  args: ["h", "file", "value"]
).
implausible_ref(h, file, value) :=
  *meta{handle: h, key: "md.implausible_ref", value: value},
  *handle{id: h, file: file}.

diagnostic("W004", "warning", h, file, null, ("implausible_ref", value)) :=
  implausible_ref(h, file, value).

@doc(
  name: "stale_reference",
  doc: "Return active handles that depend on terminal handles whose status is classified as dead for dependency validity."
).
@predicate(
  name: "stale_reference",
  args: ["src", "target", "file", "source_status", "target_status"]
).
stale_reference(src, target, file, source_status, target_status) :=
  *edge{from: src, to: target, kind: "DependsOn"},
  *handle{id: src, status: source_status, file: file},
  *handle{id: target, status: target_status},
  source_status != null,
  active(src),
  terminal(target),
  dependency_dead_status(target_status).

diagnostic("W001", "warning", src, file, null, ("stale_ref", source_status, target_status)) :=
  stale_reference(src, target, file, source_status, target_status).

builtin_dependency_dead_status("superseded").
builtin_dependency_dead_status("retired").
builtin_dependency_dead_status("archived").
builtin_dependency_dead_status("historical").
builtin_dependency_dead_status("deprecated").

builtin_dependency_valid_status("authoritative").
builtin_dependency_valid_status("complete").
builtin_dependency_valid_status("decided").
builtin_dependency_valid_status("stable").
builtin_dependency_valid_status("ratified").

configured_dependency_dead_status(status) :=
  *config{key: "dependency.dead", value: status}.

configured_dependency_valid_status(status) :=
  *config{key: "dependency.valid", value: status}.

configured_dependency_status(status) := configured_dependency_dead_status(status).
configured_dependency_status(status) := configured_dependency_valid_status(status).

@doc(
  name: "dependency_status_classification",
  doc: "Return each effective dependency-validity status classification and whether it came from a project override or the conservative builtin set."
).
@predicate(
  name: "dependency_status_classification",
  args: ["status", "classification", "origin"]
).
dependency_status_classification(status, "dead", "project") :=
  configured_dependency_dead_status(status).

dependency_status_classification(status, "valid", "project") :=
  configured_dependency_valid_status(status).

dependency_status_classification(status, "dead", "builtin") :=
  builtin_dependency_dead_status(status),
  not configured_dependency_status(status).

dependency_status_classification(status, "valid", "builtin") :=
  builtin_dependency_valid_status(status),
  not configured_dependency_status(status).

@doc(
  name: "dependency_dead_status",
  doc: "Return effective statuses whose terminal handles are dead dependency targets. Project classification overrides the builtin meaning per status."
).
@predicate(
  name: "dependency_dead_status",
  args: ["status"]
).
dependency_dead_status(status) :=
  dependency_status_classification(status, "dead", origin).

@doc(
  name: "dependency_valid_status",
  doc: "Return effective statuses whose terminal handles remain valid dependency targets. Project classification overrides the builtin meaning per status."
).
@predicate(
  name: "dependency_valid_status",
  args: ["status"]
).
dependency_valid_status(status) :=
  dependency_status_classification(status, "valid", origin).

@doc(
  name: "spec_code_drift",
  doc: "Return live spec files that cite code paths the extractor could confidently resolve as missing on disk."
).
@predicate(
  name: "spec_code_drift",
  args: ["src", "target_path", "file", "line", "source_status"]
).
spec_code_drift(src, target_path, file, line, source_status) :=
  *edge{from: src, to: ref, kind: "Cites", file: file, line: line},
  *handle{id: src, kind: "file", status: source_status},
  asserts_code(source_status),
  *handle{id: ref, kind: "external"},
  *meta{handle: ref, key: "external_class", value: "code"},
  *meta{handle: ref, key: "target_exists", value: "false"},
  *meta{handle: ref, key: "target_path", value: target_path},
  not referent_drift_evidence_present(ref).

referent_drift_evidence_present(ref) := referent_disposition(ref, disposition).

referent_warning_disposition("referent-gone").
referent_warning_disposition("referent-moved-ambiguous").

spec_code_drift(src, target_path, file, line, source_status) :=
  *edge{from: src, to: ref, kind: "Cites", file: file, line: line},
  *handle{id: src, kind: "file", status: source_status},
  asserts_code(source_status),
  *handle{id: ref, kind: "external"},
  *meta{handle: ref, key: "external_class", value: "code"},
  *meta{handle: ref, key: "target_path", value: target_path},
  referent_disposition(ref, disposition),
  referent_warning_disposition(disposition).

diagnostic("W006", "warning", src, file, line, ("spec_code_drift", target_path, source_status)) :=
  spec_code_drift(src, target_path, file, line, source_status).

@doc(
  name: "referent_disposition",
  doc: "Return drift disposition evidence for an external code referent. Rows are extraction-time git evidence, or absent when drift evidence has not been refreshed."
).
@predicate(
  name: "referent_disposition",
  args: ["target", "disposition"]
).
referent_disposition(target, disposition) :=
  *meta{handle: target, key: "code.referent_disposition", value: disposition}.

@doc(
  name: "assertion_drift",
  doc: "Return commit-count drift evidence for a design-to-code citation when the referent exists and the assertion-time oracle was available."
).
@predicate(
  name: "assertion_drift",
  args: ["spec", "target", "commits"]
).
assertion_drift(spec, target, commits) :=
  *edge{from: spec, to: target, kind: "Cites"},
  *meta{handle: target, key: "code.referent_commits_since", value: commits}.

@doc(
  name: "referent_moved_head",
  doc: "Return confident single-head move evidence for an external code referent. Ambiguous fanout remains in referent_disposition plus move-candidate metadata."
).
@predicate(
  name: "referent_moved_head",
  args: ["target", "new_path"]
).
referent_moved_head(target, new_path) :=
  *meta{handle: target, key: "code.referent_moved_to", value: new_path}.

@doc(
  name: "drift_profile",
  doc: "Aggregate design-to-code referent drift dispositions for arrival/status surfaces."
).
@predicate(
  name: "drift_profile",
  args: ["bucket", "count"]
).
drift_profile(bucket, count) :=
  referent_disposition(sample, bucket),
  count = Count{ target : referent_disposition(target, bucket) }.

@doc(
  name: "code_ref",
  doc: "Resolve markdown code citations to code-source file handles when both sources are loaded. The citation edge points to a qualified external handle; target_path metadata carries the resolvable path."
).
@predicate(
  name: "code_ref",
  args: ["spec", "ref", "path", "code_handle", "disposition"]
).
code_ref(spec, ref, path, code_handle, disposition) :=
  *edge{from: spec, to: ref, kind: "Cites", source: "markdown"},
  *handle{id: ref, kind: "external", source: "markdown"},
  *meta{handle: ref, key: "external_class", value: "code"},
  *meta{handle: ref, key: "target_path", value: path},
  *handle{id: code_handle, kind: "file", source: "code", file: file},
  path_resolves(ref, path, file),
  referent_disposition(ref, disposition).

path_resolves(ref, path, file) :=
  *meta{handle: ref, key: "external_class", value: "code"},
  *meta{handle: ref, key: "target_path", value: path},
  *handle{kind: "file", source: "code", file: file},
  path = file.

path_resolves(ref, path, file) :=
  *meta{handle: ref, key: "target_path", value: path},
  *meta{handle: ref, key: "target_resolved_path", value: resolved_path},
  *handle{kind: "file", source: "code", file: file},
  resolved_path ends_with file.

configured_pipeline_status(status, level) :=
  *config{key: "convergence.ordering", value: status, ordinal: level},
  level != null.

configured_active_status(status) :=
  *config{key: "convergence.active", value: status}.

configured_terminal_status(status) :=
  *config{key: "convergence.terminal", value: status}.

configured_asserts_code_status(status) :=
  *config{key: "convergence.asserts_code", value: status}.

configured_asserts_code_present("yes") :=
  configured_asserts_code_status(status).

aspirational_code_status("plan").
aspirational_code_status("research").
aspirational_code_status("reference").
aspirational_code_status("exploratory").

@doc(
  name: "asserts_code",
  doc: "Return lifecycle statuses that claim facts about this corpus's current code and should participate in spec-code drift checks."
).
@predicate(
  name: "asserts_code",
  args: ["status"]
).
asserts_code(status) :=
  configured_asserts_code_status(status).

asserts_code(status) :=
  *handle{id: h, status: status},
  status != null,
  active(h),
  not aspirational_code_status(status),
  not configured_asserts_code_present("yes").

configured_lifecycle_status(status) := configured_active_status(status).
configured_lifecycle_status(status) := configured_terminal_status(status).

modeled_lifecycle_status(status) :=
  lifecycle_status_classification(status, classification, origin).

modeled_terminal_status(status) :=
  lifecycle_status_classification(status, "terminal", origin).

used_lifecycle_status(status) :=
  *handle{status: status},
  status != null.

lifecycle_status_candidate(status) :=
  used_lifecycle_status(status).

lifecycle_status_candidate(status) :=
  configured_pipeline_status(status, level).

status_handle_count(status, count) :=
  lifecycle_status_candidate(status),
  count = Count{ h : *handle{id: h, status: status} }.

max_pipeline_level(level) :=
  level = Max{ l : configured_pipeline_status(status, l) }.

max_pipeline_status(status) :=
  max_pipeline_level(level),
  configured_pipeline_status(status, level).

@doc(
  name: "lifecycle_config_gap",
  doc: "Return lifecycle statuses that corpus data or ordering config use without an effective builtin or project classification, plus orderings that cannot terminate."
).
@predicate(
  name: "lifecycle_config_gap",
  args: ["status", "count", "variant"]
).
lifecycle_config_gap(status, count, "used_status_unpartitioned") :=
  used_lifecycle_status(status),
  status_handle_count(status, count),
  not modeled_lifecycle_status(status).

lifecycle_config_gap(status, count, "ordering_status_unpartitioned") :=
  configured_pipeline_status(status, level),
  status_handle_count(status, count),
  not modeled_lifecycle_status(status).

lifecycle_config_gap(status, count, "ordering_not_terminal") :=
  max_pipeline_status(status),
  status_handle_count(status, count),
  not modeled_terminal_status(status).

diagnostic("W005", "warning", status, null, null, ("lifecycle_config_gap", status, count, variant)) :=
  lifecycle_config_gap(status, count, variant).

@doc(
  name: "frontmatter_mapping_alias",
  doc: "Return the finite exact frontmatter alias vocabulary behind W007 and the conventional field, edge kind, and direction each alias suggests."
).
@predicate(
  name: "frontmatter_mapping_alias",
  args: ["key", "suggested_field", "edge_kind", "direction"]
).
frontmatter_mapping_alias("references", "references", "Cites", "forward").
frontmatter_mapping_alias("refs", "references", "Cites", "forward").
frontmatter_mapping_alias("relates", "references", "Cites", "forward").
frontmatter_mapping_alias("related", "references", "Cites", "forward").
frontmatter_mapping_alias("related-to", "references", "Cites", "forward").
frontmatter_mapping_alias("related_to", "references", "Cites", "forward").
frontmatter_mapping_alias("pins", "references", "Cites", "forward").
frontmatter_mapping_alias("companion-to", "references", "Cites", "forward").
frontmatter_mapping_alias("companion_to", "references", "Cites", "forward").
frontmatter_mapping_alias("see-also", "references", "Cites", "forward").
frontmatter_mapping_alias("see_also", "references", "Cites", "forward").
frontmatter_mapping_alias("tracked-by", "references", "Cites", "forward").
frontmatter_mapping_alias("tracked_by", "references", "Cites", "forward").
frontmatter_mapping_alias("cites", "references", "Cites", "forward").

frontmatter_mapping_alias("builds-on", "depends-on", "DependsOn", "forward").
frontmatter_mapping_alias("builds_on", "depends-on", "DependsOn", "forward").
frontmatter_mapping_alias("extends", "depends-on", "DependsOn", "forward").
frontmatter_mapping_alias("requires", "depends-on", "DependsOn", "forward").
frontmatter_mapping_alias("dependencies", "depends-on", "DependsOn", "forward").
frontmatter_mapping_alias("depends_on", "depends-on", "DependsOn", "forward").

frontmatter_mapping_alias("superseded_by", "superseded-by", "Supersedes", "forward").
frontmatter_mapping_alias("replaced-by", "superseded-by", "Supersedes", "forward").
frontmatter_mapping_alias("replaced_by", "superseded-by", "Supersedes", "forward").
frontmatter_mapping_alias("replaces", "supersedes", "Supersedes", "inverse").
frontmatter_mapping_alias("obsoletes", "supersedes", "Supersedes", "inverse").

@doc(
  name: "configured_frontmatter_alias",
  doc: "Return W007 aliases that have an explicit project frontmatter edge mapping and are therefore suppressed."
).
@predicate(
  name: "configured_frontmatter_alias",
  args: ["key"]
).
configured_frontmatter_alias("references") :=
  *config{key: "frontmatter.field.references.edge_kind", value: kind}.
configured_frontmatter_alias("refs") :=
  *config{key: "frontmatter.field.refs.edge_kind", value: kind}.
configured_frontmatter_alias("relates") :=
  *config{key: "frontmatter.field.relates.edge_kind", value: kind}.
configured_frontmatter_alias("related") :=
  *config{key: "frontmatter.field.related.edge_kind", value: kind}.
configured_frontmatter_alias("related-to") :=
  *config{key: "frontmatter.field.related-to.edge_kind", value: kind}.
configured_frontmatter_alias("related_to") :=
  *config{key: "frontmatter.field.related_to.edge_kind", value: kind}.
configured_frontmatter_alias("pins") :=
  *config{key: "frontmatter.field.pins.edge_kind", value: kind}.
configured_frontmatter_alias("companion-to") :=
  *config{key: "frontmatter.field.companion-to.edge_kind", value: kind}.
configured_frontmatter_alias("companion_to") :=
  *config{key: "frontmatter.field.companion_to.edge_kind", value: kind}.
configured_frontmatter_alias("see-also") :=
  *config{key: "frontmatter.field.see-also.edge_kind", value: kind}.
configured_frontmatter_alias("see_also") :=
  *config{key: "frontmatter.field.see_also.edge_kind", value: kind}.
configured_frontmatter_alias("tracked-by") :=
  *config{key: "frontmatter.field.tracked-by.edge_kind", value: kind}.
configured_frontmatter_alias("tracked_by") :=
  *config{key: "frontmatter.field.tracked_by.edge_kind", value: kind}.
configured_frontmatter_alias("cites") :=
  *config{key: "frontmatter.field.cites.edge_kind", value: kind}.
configured_frontmatter_alias("builds-on") :=
  *config{key: "frontmatter.field.builds-on.edge_kind", value: kind}.
configured_frontmatter_alias("builds_on") :=
  *config{key: "frontmatter.field.builds_on.edge_kind", value: kind}.
configured_frontmatter_alias("extends") :=
  *config{key: "frontmatter.field.extends.edge_kind", value: kind}.
configured_frontmatter_alias("requires") :=
  *config{key: "frontmatter.field.requires.edge_kind", value: kind}.
configured_frontmatter_alias("dependencies") :=
  *config{key: "frontmatter.field.dependencies.edge_kind", value: kind}.
configured_frontmatter_alias("depends_on") :=
  *config{key: "frontmatter.field.depends_on.edge_kind", value: kind}.
configured_frontmatter_alias("superseded_by") :=
  *config{key: "frontmatter.field.superseded_by.edge_kind", value: kind}.
configured_frontmatter_alias("replaced-by") :=
  *config{key: "frontmatter.field.replaced-by.edge_kind", value: kind}.
configured_frontmatter_alias("replaced_by") :=
  *config{key: "frontmatter.field.replaced_by.edge_kind", value: kind}.
configured_frontmatter_alias("replaces") :=
  *config{key: "frontmatter.field.replaces.edge_kind", value: kind}.
configured_frontmatter_alias("obsoletes") :=
  *config{key: "frontmatter.field.obsoletes.edge_kind", value: kind}.

frontmatter_unmapped_alias_use(key, h) :=
  frontmatter_mapping_alias(key, suggested_field, edge_kind, direction),
  *meta{handle: h, key: key, value: value, role: "authored_unmodeled"},
  *meta{handle: h, key: "md.parent_dir", value: parent_dir},
  not configured_frontmatter_alias(key).

@doc(
  name: "frontmatter_mapping_gap",
  doc: "Return exact reference-like markdown frontmatter aliases that have no configured edge mapping, aggregated by distinct file handle, with the conventional field, edge kind, and direction to configure."
).
@predicate(
  name: "frontmatter_mapping_gap",
  args: ["key", "distinct_handle_count", "suggested_field", "edge_kind", "direction"]
).
frontmatter_mapping_gap(key, distinct_handle_count, suggested_field, edge_kind, direction) :=
  frontmatter_mapping_alias(key, suggested_field, edge_kind, direction),
  frontmatter_unmapped_alias_use(key, sample),
  distinct_handle_count = Count{ h : frontmatter_unmapped_alias_use(key, h) }.

diagnostic("W007", "warning", key, null, null, ("frontmatter_mapping_gap", key, distinct_handle_count, suggested_field, edge_kind, direction)) :=
  frontmatter_mapping_gap(key, distinct_handle_count, suggested_field, edge_kind, direction).

@doc(
  name: "frontmatter_reference_name_signal",
  doc: "Return unmodeled frontmatter keys containing a finite lowercase substring fragment associated with references. This is a ranking signal only: it never infers or suggests an edge kind."
).
@predicate(
  name: "frontmatter_reference_name_signal",
  args: ["key"]
).
frontmatter_reference_name_fragment("ref").
frontmatter_reference_name_fragment("link").
frontmatter_reference_name_fragment("cite").
frontmatter_reference_name_fragment("relat").
frontmatter_reference_name_fragment("source").
frontmatter_reference_name_fragment("depend").
frontmatter_reference_name_fragment("require").
frontmatter_reference_name_fragment("supersed").
frontmatter_reference_name_fragment("replace").
frontmatter_reference_name_fragment("extend").
frontmatter_reference_name_fragment("build").
frontmatter_reference_name_fragment("track").
frontmatter_reference_name_fragment("pin").
frontmatter_reference_name_fragment("companion").

frontmatter_reference_name_signal(key) :=
  unmodeled_frontmatter_key_present(key),
  frontmatter_reference_name_fragment(fragment),
  key contains fragment.

frontmatter_mapping_alias_key(key) :=
  frontmatter_mapping_alias(key, suggested_field, edge_kind, direction).

unmodeled_frontmatter_key_use(key, h) :=
  *handle{id: h, kind: "file"},
  *meta{handle: h, key: key, role: "authored_unmodeled", source: "markdown"},
  not frontmatter_mapping_alias_key(key).

unmodeled_frontmatter_key_present(key) :=
  unmodeled_frontmatter_key_use(key, h).

unmodeled_frontmatter_key_signal(key, 1) :=
  unmodeled_frontmatter_key_use(key, sample),
  frontmatter_reference_name_signal(key).

unmodeled_frontmatter_key_signal(key, 0) :=
  unmodeled_frontmatter_key_use(key, sample),
  not frontmatter_reference_name_signal(key).

unmodeled_frontmatter_rank_weight(key, h, 2) :=
  unmodeled_frontmatter_key_use(key, h).

unmodeled_frontmatter_rank_weight(key, key, 1) :=
  frontmatter_reference_name_signal(key).

@doc(
  name: "unmodeled_frontmatter_key",
  doc: "Rank authored markdown frontmatter keys that no typed projection consumes and W007 does not already cover. Counts are distinct file handles; reference_name_signal only breaks equal-count ties and never suggests an edge kind."
).
@predicate(
  name: "unmodeled_frontmatter_key",
  args: ["key", "distinct_file_handles", "reference_name_signal", "rank"]
).
unmodeled_frontmatter_key(key, distinct_file_handles, reference_name_signal, rank) :=
  unmodeled_frontmatter_key_use(key, sample),
  distinct_file_handles = Count{ h : unmodeled_frontmatter_key_use(key, h) },
  unmodeled_frontmatter_key_signal(key, reference_name_signal),
  rank = Sum{ weight : unmodeled_frontmatter_rank_weight(key, unit, weight) }.

terminal_status_used(status) :=
  *handle{id: h, status: status},
  status != null,
  terminal(h).

terminal_status_handle_count(status, count) :=
  terminal_status_used(status),
  count = Count{ h : *handle{id: h, status: status}, terminal(h) }.

@doc(
  name: "dependency_config_gap",
  doc: "Return terminal statuses whose dependency validity is unknown, aggregated by status. Classify one with config dependency { dead([\"status\"]). } or valid([\"status\"]). }."
).
@predicate(
  name: "dependency_config_gap",
  args: ["status", "count", "variant"]
).
dependency_config_gap(status, count, "terminal_status_unclassified") :=
  terminal_status_handle_count(status, count),
  not dependency_dead_status(status),
  not dependency_valid_status(status).

diagnostic("S006", "suggestion", status, null, null, ("dependency_config_gap", status, count, variant)) :=
  dependency_config_gap(status, count, variant).

handle_file(h, file) :=
  *handle{id: h, file: file},
  file != "".

handle_file(h, file) :=
  *meta{handle: h, key: "md.resolved_file", value: file}.

@doc(
  name: "confidence_gap",
  doc: "Return dependency edges where the source handle is more than one pipeline step ahead of its target."
).
@predicate(
  name: "confidence_gap",
  args: ["src", "target", "file", "source_status", "source_level", "target_status", "target_level"]
).
confidence_gap(src, target, file, source_status, source_level, target_status, target_level) :=
  *edge{from: src, to: target, kind: "DependsOn"},
  *handle{id: src, status: source_status, file: file},
  *handle{id: target, status: target_status},
  pipeline_position(src, source_level),
  pipeline_position(target, target_level),
  source_level > target_level + 1.

diagnostic("W002", "warning", src, file, null, ("confidence_gap", source_status, source_level, target_status, target_level)) :=
  confidence_gap(src, target, file, source_status, source_level, target_status, target_level).

@doc(
  name: "undischarged_obligation",
  doc: "Return live obligation handles that have no Discharges edge."
).
@predicate(
  name: "undischarged_obligation",
  args: ["h", "file"]
).
undischarged_obligation(h, file) :=
  obligation(h),
  not terminal(h),
  discharge_count(h, 0),
  handle_file(h, file).

diagnostic("E002", "error", h, file, null, "undischarged") :=
  undischarged_obligation(h, file).

@doc(
  name: "multiple_discharge",
  doc: "Return obligation handles with multiple Discharges edges so agents can check whether the redundancy is intentional."
).
@predicate(
  name: "multiple_discharge",
  args: ["h", "file", "count"]
).
multiple_discharge(h, file, count) :=
  obligation(h),
  not terminal(h),
  discharge_count(h, count),
  count >= 2,
  handle_file(h, file).

diagnostic("I002", "info", h, file, null, ("multiple_discharges", count)) :=
  multiple_discharge(h, file, count).

file_parent_dir(h, dir) :=
  *handle{id: h, kind: "file"},
  *meta{handle: h, key: "md.parent_dir", value: dir}.

parent_dir_present(dir) :=
  file_parent_dir(h, dir).

parent_dir_file_count(dir, total) :=
  parent_dir_present(dir),
  total = Count{ h : file_parent_dir(h, dir) },
  total >= 2.

parent_dir_frontmatter_count(dir, with_frontmatter) :=
  parent_dir_present(dir),
  with_frontmatter = Count{ h : file_parent_dir(h, dir), *handle{id: h, status: status}, status != null }.

frontmatter_adoption_high(dir, with_frontmatter, total) :=
  parent_dir_file_count(dir, total),
  parent_dir_frontmatter_count(dir, with_frontmatter),
  with_frontmatter * 2 > total.

@doc(
  name: "missing_frontmatter_file",
  doc: "Return files missing status frontmatter in directories where frontmatter adoption is already high."
).
@predicate(
  name: "missing_frontmatter_file",
  args: ["h", "dir", "file"]
).
missing_frontmatter_file(h, dir, file) :=
  *handle{id: h, kind: "file", status: null, file: file},
  file_parent_dir(h, dir),
  frontmatter_adoption_high(dir, with_frontmatter, total).

diagnostic("W003", "warning", h, file, null, null) :=
  missing_frontmatter_file(h, dir, file).

@doc(
  name: "orphaned_handle",
  doc: "Return label and version handles that have no incoming references and may be cleanup candidates."
).
orphaned_handle(h) :=
  *handle{id: h, kind: "label"},
  in_degree(h, 0).

orphaned_handle(h) :=
  *handle{id: h, kind: "version"},
  in_degree(h, 0),
  *edge{from: h, kind: "Supersedes"}.

diagnostic("S001", "suggestion", h, file, null, ("orphaned_handle", kind, h)) :=
  orphaned_handle(h),
  *handle{id: h, kind: kind},
  handle_file(h, file).

rejected_namespace(namespace) :=
  *config{key: "handles.rejected", value: namespace}.

namespace_label(namespace, h) :=
  *handle{id: h, kind: "label", namespace: namespace},
  namespace != "".

namespace_present(namespace) :=
  namespace_label(namespace, h).

namespace_label_count(namespace, count) :=
  namespace_present(namespace),
  count = Count{ h : namespace_label(namespace, h) }.

next_pipeline_status(status, next_status) :=
  configured_pipeline_status(status, level),
  configured_pipeline_status(next_status, next_level),
  next_level = level + 1.

status_population(status, count) :=
  configured_pipeline_status(status, level),
  status_handle_count(status, count).

forward_dependency_to_next_status(status, next_status) :=
  *handle{id: h, status: status},
  *edge{from: h, to: target, kind: "DependsOn"},
  *handle{id: target, status: next_status}.

snapshot_history_exists("yes") :=
  snapshot_history_present(count).

previous_status_population(status, count) :=
  snapshot_history_exists("yes"),
  configured_pipeline_status(status, level),
  count = Count{ h : at("snapshot:last") { *handle{id: h, status: status} } }.

s003_pipeline_stall(status, count, next_status, true) :=
  snapshot_history_exists("yes"),
  status_population(status, count),
  previous_status_population(status, previous_count),
  next_pipeline_status(status, next_status),
  count >= previous_count,
  previous_count >= 3.

@doc(
  name: "pipeline_stall",
  doc: "Return lifecycle statuses whose population is not decreasing across automatic status snapshots."
).
@predicate(
  name: "pipeline_stall",
  args: ["status", "count", "next_status", "based_on_history"]
).
pipeline_stall(status, count, next_status, based_on_history) :=
  s003_pipeline_stall(status, count, next_status, based_on_history).

diagnostic("S003", "suggestion", status, null, null, ("pipeline_stall", status, count, next_status, based_on_history)) :=
  pipeline_stall(status, count, next_status, based_on_history).

active_namespace(namespace) :=
  namespace_present(namespace),
  not rejected_namespace(namespace).

active_namespace_member(namespace, h) :=
  active_namespace(namespace),
  namespace_label(namespace, h).

active_namespace_size(namespace, total) :=
  active_namespace(namespace),
  total = Count{ h : active_namespace_member(namespace, h) },
  total >= 2.

abandoned_terminal_member(namespace, h) :=
  active_namespace_member(namespace, h),
  terminal(h).

abandoned_stale_member(namespace, h) :=
  active_namespace_member(namespace, h),
  not terminal(h),
  freshness(h, days),
  days >= 90.

abandoned_terminal_count(namespace, count) :=
  active_namespace_size(namespace, total),
  count = Count{ h : abandoned_terminal_member(namespace, h) }.

abandoned_stale_count(namespace, count) :=
  active_namespace_size(namespace, total),
  count = Count{ h : abandoned_stale_member(namespace, h) }.

s004_abandoned_namespace(namespace, total, terminal_count, stale_count) :=
  active_namespace_size(namespace, total),
  abandoned_terminal_count(namespace, terminal_count),
  abandoned_stale_count(namespace, stale_count),
  terminal_count + stale_count = total.

@doc(
  name: "abandoned_namespace",
  doc: "Return active label namespaces where every member is terminal or stale."
).
@predicate(
  name: "abandoned_namespace",
  args: ["namespace", "total", "terminal_count", "stale_count"]
).
abandoned_namespace(namespace, total, terminal_count, stale_count) :=
  s004_abandoned_namespace(namespace, total, terminal_count, stale_count).

active_namespace_representative_file(namespace, file) :=
  active_namespace_size(namespace, total),
  file = Min{ f : active_namespace_member(namespace, h), handle_file(h, f) }.

diagnostic("S004", "suggestion", namespace, file, null, ("abandoned_namespace", namespace, total, terminal_count, stale_count)) :=
  abandoned_namespace(namespace, total, terminal_count, stale_count),
  active_namespace_representative_file(namespace, file).

file_prefix(file, prefix) :=
  *handle{id: file, kind: "file"},
  *edge{from: file, to: label, kind: "Cites"},
  *handle{id: label, kind: "label", namespace: prefix},
  prefix != "".

file_prefix(file, prefix) :=
  *handle{id: file, kind: "file"},
  *edge{from: file, to: label, kind: "DependsOn"},
  *handle{id: label, kind: "label", namespace: prefix},
  prefix != "".

same_concern_pair(left_prefix, right_prefix) :=
  *concern{name: concern, member: left_member},
  *concern{name: concern, member: right_member},
  *handle{id: left_member, kind: "label", namespace: left_prefix},
  *handle{id: right_member, kind: "label", namespace: right_prefix},
  left_prefix < right_prefix.

prefix_pair_candidate(left_prefix, right_prefix) :=
  active_namespace(left_prefix),
  active_namespace(right_prefix),
  left_prefix < right_prefix.

s005_pair_count(left_prefix, right_prefix, count) :=
  prefix_pair_candidate(left_prefix, right_prefix),
  count = Count{ file : file_prefix(file, left_prefix), file_prefix(file, right_prefix) },
  count >= 3,
  not same_concern_pair(left_prefix, right_prefix).

s005_top_pair(left_prefix, right_prefix, count) :=
  (left_prefix, right_prefix, count) = TopK{ k: 5, key: count :
    (left_prefix, right_prefix, count) :
      s005_pair_count(left_prefix, right_prefix, count)
  }.

@doc(
  name: "top_pair",
  doc: "Return the strongest namespace-prefix pairs that often co-occur and may deserve a configured concern group."
).
@predicate(
  name: "top_pair",
  args: ["left_prefix", "right_prefix", "count"]
).
top_pair(left_prefix, right_prefix, count) :=
  s005_top_pair(left_prefix, right_prefix, count).

diagnostic("S005", "suggestion", left_prefix, null, null, ("concern_group_candidate", left_prefix, right_prefix, count)) :=
  top_pair(left_prefix, right_prefix, count).
